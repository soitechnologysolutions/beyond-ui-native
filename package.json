{
  "name": "beyond-ui-native-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@beyondcorp/beyond-ui-native",
    "typecheck": "npm run typecheck --workspace=@beyondcorp/beyond-ui-native",
    "test": "npm run test --workspace=@beyondcorp/beyond-ui-native",
    "example:start": "npm run start --workspace=example-app",
    "example:web": "npm run web --workspace=example-app"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "@types/react": "^18.3.12",
    "react-native": "0.76.2",
    "react-native-reanimated": "~3.16.1",
    "metro": "0.81.5",
    "metro-config": "0.81.5"
  }
}
